# `npm run setup` generates this file with a strong secret and admin password.
# Copy this by hand only if you would rather set the values yourself.

# Signing key for session tokens. Generate one, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
JWT_SECRET=

# Where the SQLite database lives. Back this file up — it holds every rate
# version, job and audit record.
DB_PATH=./data/semcom.db

PORT=4000

# Only needed when the frontend is served from somewhere other than this
# server, i.e. the Vite dev server. Leave unset in production.
CORS_ORIGIN=http://localhost:5173

# Set to true only if the tool sits behind HTTPS. On a plain-HTTP office LAN
# leave it unset, or browsers will refuse to send the session cookie back.
# COOKIE_SECURE=true

# First admin, created only when the users table is empty. In production the
# server refuses to start unless SEED_ADMIN_PASSWORD is set.
SEED_ADMIN_EMAIL=admin@sem.com.au
SEED_ADMIN_PASSWORD=
