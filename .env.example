# Copy to .env and set before the first run.

# Signing key for session tokens. Generate one, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
JWT_SECRET=

# Where the SQLite database lives. Back this file up — it holds every rate
# version, job and audit record.
DB_PATH=./data/semcom.db

PORT=4000

# Origin allowed to call the API. Only needed when the frontend is served
# from somewhere other than this server (e.g. the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# First admin, created only when the users table is empty.
SEED_ADMIN_EMAIL=admin@sem.com.au
SEED_ADMIN_PASSWORD=
